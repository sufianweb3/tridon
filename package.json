{
  "name": "agentspend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agentspend/web dev",
    "build": "pnpm --filter @agentspend/web build",
    "start": "pnpm --filter @agentspend/web start",
    "lint": "pnpm --filter @agentspend/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @agentspend/core test && pnpm --filter @agentspend/near test",
    "test:e2e": "tsx --env-file-if-exists=.env.local scripts/e2e.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset-db.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neon/functions": "^0.11.0",
    "pg": "^8.23.1"
  }
}
