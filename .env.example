# AgentSpend environment template.
# Copy to `.env.local` for local development. Every value below is a placeholder
# or a safe local default. Never commit `.env.local` or real secrets.

# Public origin used for NEP-413 challenges and links.
AGENTSPEND_APP_URL=http://localhost:3000

# Postgres is the only data store. Neon injects this via `neon env pull`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
# AGENTSPEND_DB_POOL_MAX=5

# Neon Auth (Managed Better Auth). `neon deploy` writes the base URL.
# Generate the cookie secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=

# Neon Realtime. Only the URL is sent to the browser (as a prop); the secret
# stays on the server and seals each user-scoped query.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Neon Object Storage (S3-compatible). `neon env pull` writes all four.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
# Bucket that holds settlement receipt JSON.
NEON_STORAGE_BUCKET=assets

# Deployed Neon Function that reports agent budget/payment status.
NEON_FUNCTION_HELLO_BASE_URL=
# Shared server-to-server secret for that function. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AGENTSPEND_FUNCTION_SECRET=

# NEAR testnet only. Do not point these at mainnet.
AGENTSPEND_NEAR_RPC=https://rpc.testnet.near.org
AGENTSPEND_NEAR_HELPER=https://helper.testnet.near.org

# Demo controls. Set either to 0 to disable.
# AGENTSPEND_DEMO=0 removes the one-click demo sign-in and merchant portal login.
# AGENTSPEND_LIVE_RAIL=0 disables new testnet vault provisioning/payments.
AGENTSPEND_DEMO=1
AGENTSPEND_LIVE_RAIL=1

# Local directory for the master key when AGENTSPEND_MASTER_KEY is unset.
# AGENTSPEND_DATA_DIR=./data

# 32-byte base64 key used to encrypt the demo signer's testnet keys at rest.
# If unset, a random key is generated at data/master.key on first run.
# Generate a value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AGENTSPEND_MASTER_KEY=

# Outbound merchant webhooks are disabled unless the endpoint host appears in
# this comma-separated allowlist. This is the SSRF control, not a convenience.
# AGENTSPEND_WEBHOOK_HOSTS=webhook.example.com,staging.example.com

# Only for local webhook testing. Allows http://localhost and http://127.0.0.1
# in addition to HTTPS. Never enable in production.
AGENTSPEND_ALLOW_INSECURE_WEBHOOKS=0
